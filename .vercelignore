*.tsbuildinfo

# output ディレクトリ（バックアップ、キャッシュ、レポートなど）
output/backups/
output/html_cache/
output/reports/
output/master/

# ランキングデータ（外部ストレージから取得するもののみ除外）
public/data/rankings/

# 1950〜の巨大CSV（本番ビルド・APIでは不要。英字名は master_csv_calculated の 2025 のみ＋名簿）
_data/master_csv__import_1950_2024/
_data/master_csv/

# 工場・スクレイプ・PoC（本番表示は R2。Vercel ビルドから除外）
_data/scraped_games/**
!_data/scraped_games/derived/
_data/scraped_games/derived/**
!_data/scraped_games/derived/*_batting_master_bridge.csv
_data/cache/
