# Vercelデプロイ時に除外する巨大データ
# Functionサイズ超過を防ぐため

# ローカル依存物・ビルド生成物
node_modules/
.next/
.git/
.cursor/
.agents/
.codex/

# ドキュメント・ローカル補助物
docs/
tests/
logs/
_reports/
_tools/
