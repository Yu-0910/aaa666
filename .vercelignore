# Vercelデプロイ時に除外する巨大データ
# Functionサイズ超過を防ぐため

# ローカル依存物・ビルド生成物
node_modules/
.next/
.git/
.cursor/
.agents/
.codex/

# ドキュメント・ローカル補助物
docs/
tests/
logs/
_reports/
_tools/
*.log
*.tsbuildinfo

# output ディレクトリ（バックアップ、キャッシュ、レポートなど）
output/backups/
output/html_cache/
output/reports/
output/master/

# ランキングデータ（外部ストレージから取得するもののみ除外）
public/data/*
!public/data/top-probables/
!public/data/top-probables/**

# 1950〜の巨大CSV（本番ビルド・APIでは不要。英字名は master_csv_calculated の 2025 のみ＋名簿）
_data/*
!_data/npb_roster_2026.csv
!_data/scraped_games
_data/scraped_games/*
!_data/scraped_games/derived
_data/scraped_games/derived/*
!_data/scraped_games/derived/2021038624_batting_master_bridge.csv

# 工場・スクレイプ・PoC（本番表示は R2。Vercel ビルドから除外）
output/*
output/html_cache_probe/
output/temp/
